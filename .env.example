# Copy to .env next to docker-compose.yml, then fill in what you use.
# Folder and performance values are read on first start to create config.json;
# after that, change them in Settings. Credentials are read on every start.

DATA_DIR=/data

# Music folders to index (comma-separated). The one named deezer-dl receives
# the downloads unless DEEZER_DL_DIR says otherwise.
SCAN_DIRS=/music/deezer-dl,/music/library

# Where to write the M3U8 playlists
PLAYLISTS_BASE_DIR=/music/playlists

# The same folders as Navidrome sees them: /in/this/app:/in/navidrome
HOST_TO_NAVIDROME_ROOT=/music/deezer-dl:/deezer-dl,/music/library:/music

# Optional: where the downloads are written
# DEEZER_DL_DIR=/music/deezer-dl

# Threads per music folder during the library scan:
#   2 spinning HDD, 4 fast HDD or RAID, 8 SSD or NVMe
LIBRARY_WORKERS_PER_DIR=2
# Matching threads (rapidfuzz releases the GIL): your Docker CPU count
MATCH_WORKERS=4
# Files Fix missing metadata handles at once (about 80 MB of memory each)
METADATA_WORKERS=4
# Downloads from Deezer at the same time: Deezer throttles, keep it low
# DOWNLOAD_WORKERS=4

# The key the saved credentials (Deezer ARLs, Navidrome passwords, tokens) are
# encrypted with: any long random string. Without it, a key is generated in
# /data, so a copy of /data carries it along.
D2N_ENCRYPTION_KEY=

# Optional: behind a reverse proxy (Traefik, nginx…). TRUSTED_PROXIES is the
# number of proxies in front of the app; keep it unset without one.
# TRUSTED_PROXIES=1
# COOKIE_SECURE=true

# Optional: run as this user and group instead of root (`id -u`, `id -g`). The
# data folder is given to them; the music folders must be writable by them.
# PUID=1000
# PGID=1000

# Optional: listening stats. Sources for Settings > Listening stats, and the
# token Navidrome sends new plays with (else create one in Settings).
# STATS_NAVIDROME_DB=/import/navidrome/navidrome.db
# STATS_MALOJA_DB=/import/maloja/malojadb.sqlite
# SCROBBLE_TOKEN=

# Optional: the sign-in account (else the first visit asks you to create it),
# and the API token CatBoard uses (else create one in Settings).
# APP_USERNAME=admin
# APP_PASSWORD=a-long-password
# API_TOKEN=a-long-random-token

# Optional: the arl cookie of a Deezer account (else add it in Settings). A free
# account downloads MP3 128 kbps: add a premium account's for FLAC downloads.
# DEEZER_ARL=
# DEEZER_ARL_PREMIUM=

# Optional: session signing key (else a random one is kept in /data)
# SECRET_KEY=

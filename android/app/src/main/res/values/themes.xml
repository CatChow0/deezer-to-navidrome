<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; the window only needs the ink background,
         so the first frame is never white. -->
    <style name="Theme.D2N" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
